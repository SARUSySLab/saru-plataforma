# Postgres da PoC (compose sobe nesta porta; 5432 e 5433 ja estao ocupadas na maquina)
SARU_PG_HOST=127.0.0.1
SARU_PG_PORT=5442
SARU_PG_DB=saru_poc
SARU_PG_USER=saru
SARU_PG_PASSWORD=saru

# Raiz do armazenamento colunar. Amostra nunca entra no Postgres:
# vai pra Parquet aqui, e serie_amostral guarda so o ponteiro (URI, linhas, taxa).
# Trocar por s3://... no dia da migracao muda so esta linha.
SARU_DATA_ROOT=./data

# Acervo de leitura (read-only). 4,6 GB, fora do repo de proposito.
SARU_ACERVO_ROOT=/home/lucas-antunes/Desktop/trabalho/clientes/saru/dados_telemetria

# Snapshot do saru-app usado como referencia de leitor e de aliases.yaml.
# A PoC nao escreve nada aqui (decisao 3 do plano: zero toque no saru-app).
SARU_APP_REF=/home/lucas-antunes/Desktop/trabalho/clientes/saru/tudo_junto/saru-app

# OpenRouter, chave do assistente de IA (fase 9 do plano de integracao).
# Pegar em https://openrouter.ai/keys. Nunca commitar o valor real.
SARU_OPENROUTER_KEY=sk-or-v1-troque-por-uma-chave-real

# Assinatura do JWT de sessao. Gere o seu: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Em producao e OBRIGATORIO: a API recusa subir com o default.
SARU_JWT_SECRET=gere-o-seu-com-secrets-token-urlsafe-48
SARU_JWT_HORAS=12
# 1 em producao (cookie so viaja em HTTPS), 0 em dev (localhost e http).
SARU_COOKIE_SEGURO=0
SARU_AMBIENTE=dev
# Modelo do Sarue no OpenRouter.
SARU_OPENROUTER_MODELO=anthropic/claude-sonnet-4.5

# Clima (fase 10 do plano). Default e Open-Meteo, sem chave: SARU_CLIMA_BASE
# ja tem o valor certo, nao precisa setar nada pra isso funcionar.
#
# Incidente 29/08: o Open-Meteo limita por IP, e o IP de saida do Railway e
# compartilhado entre clientes da plataforma, entao a cota diaria as vezes ja
# chega estourada (429) mesmo sem trafego nosso. SARU_OPENWEATHER_KEY e o
# fallback pra esse problema especifico: o free tier do OpenWeather limita
# por CHAVE, nao por IP. So sete se o 429 do Open-Meteo estiver incomodando
# em producao; em dev local nao e necessario. Pegar em
# https://home.openweathermap.org/api_keys. Nunca commitar o valor real.
# Sem essa chave definida o comportamento e identico ao Open-Meteo puro.
SARU_OPENWEATHER_KEY=

# met.no (Instituto Meteorologico da Noruega): ultimo fallback da cascata,
# entra so se o primario (OpenWeather ou Open-Meteo) falhar. Sem chave, sem
# cadastro, mas o User-Agent abaixo e OBRIGATORIO pelos termos de uso deles
# (identifica app + contato); sem ele a resposta e bloqueada. Os defaults ja
# funcionam, so trocar o contato se quiser outro e-mail no lugar.
SARU_METNO_BASE=https://api.met.no/weatherapi/locationforecast/2.0/compact
SARU_METNO_USER_AGENT=SARU-Analyzer/0.1 (contato@lassoftware.com.br)
