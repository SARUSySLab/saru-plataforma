# Postgres da PoC (compose sobe nesta porta; 5432 e 5433 ja estao ocupadas na maquina)
SARU_PG_HOST=127.0.0.1
SARU_PG_PORT=5442
SARU_PG_DB=saru_poc
SARU_PG_USER=saru
SARU_PG_PASSWORD=saru

# Raiz do armazenamento colunar. Amostra nunca entra no Postgres:
# vai pra Parquet aqui, e serie_amostral guarda so o ponteiro (URI, linhas, taxa).
# Trocar por s3://... no dia da migracao muda so esta linha.
SARU_DATA_ROOT=./data

# Acervo de leitura (read-only). 4,6 GB, fora do repo de proposito.
SARU_ACERVO_ROOT=/home/lucas-antunes/Desktop/trabalho/clientes/saru/dados_telemetria

# Snapshot do saru-app usado como referencia de leitor e de aliases.yaml.
# A PoC nao escreve nada aqui (decisao 3 do plano: zero toque no saru-app).
SARU_APP_REF=/home/lucas-antunes/Desktop/trabalho/clientes/saru/tudo_junto/saru-app
